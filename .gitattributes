# Text files use LF everywhere: stored with LF in the repository, and checked out with LF
# on every machine, whatever core.autocrlf says. This matches .editorconfig and Spotless.
* text=auto eol=lf

# Shell scripts must keep LF, or they fail on Linux/macOS (e.g. GitHub Actions)
gradlew text eol=lf
*.sh    text eol=lf

# Windows scripts must keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary files: never touch line endings, never diff as text
*.jar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ttf   binary
*.otf   binary
