# Normalize line endings: text files are stored with LF in the repository
* text=auto

# Shell scripts must keep LF, or they fail on Linux/macOS (e.g. GitHub Actions)
gradlew text eol=lf
*.sh    text eol=lf

# Windows scripts must keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary files: never touch line endings, never diff as text
*.jar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ttf   binary
*.otf   binary
